{
  "name": "bookieball",
  "version": "1.0.0",
  "description": "Bookieball CLI + local web app",
  "type": "module",
  "bin": {
    "bookieball": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "tsx src/cli.ts start",
    "start:prod": "npm run build:web && tsx src/cli.ts start --prod",
    "init": "tsx src/cli.ts init",
    "reset": "tsx src/cli.ts reset --yes",
    "dev:api": "tsx src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "lint": "tsc --noEmit",
    "test": "npm run lint && npm run test:cup && npm run test:trio && npm run test:studio",
    "test:cup": "tsx scripts/cup-regression.ts",
    "test:trio": "tsx scripts/trio-regression.ts",
    "test:studio": "tsx scripts/studio-regression.ts",
    "test:smoke": "node scripts/browser-smoke.mjs",
    "test:layout": "node scripts/layout-regression.mjs",
    "test:ci": "npm run test && npm run build && npm run test:layout"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "commander": "^12.1.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "framer-motion": "^12.34.0",
    "open": "^10.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.58.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
